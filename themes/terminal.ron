    "metrics": {
        "space-xs": 4,
        "space-s": 6,
        "space-m": 12,
        "space-l": 18,
        "space-xl": 24,
        "radius-s": 0,
        "radius-m": 0,
        "radius-l": 0,
        "radius-menu": 0,
        "radius-popover": 0,
        "radius-toast": 0,
        "radius-window": 0,
        "button-padding-y": 2,
        "button-padding-x": 8,
        "button-min-height": 24,
        "entry-padding-y": 6,
        "entry-padding-x": 9,
        "entry-min-height": 24,
        "border-width": 1,
        "icon-size": 16,
        "row-padding-y": 3,
        "row-padding-x": 12,
        "row-min-height": 30,
        "row-spacing": 12,
        "card-padding": 8,
        "dialog-padding": 24,
        "popover-padding": 8,
        "page-padding-y": 24,
        "page-padding-x": 12,
        "group-spacing": 24,
        "clamp-maximum": 600,
        "headerbar-height": 34,
        "gutter": 10,
        "band-air": 8,
        "sidebar-width": 240,
        "sidebar-row-height": 26,
        "scrollbar-width": 8,
        "space-xxs": 2,
        "space-xxl": 36,
        "radius-pill": 0,
        "pill-padding-y": 10,
        "pill-padding-x": 32,
        "focus-ring-width": 2,
        "switch-size": 26,
        "checkbox-size": 20,
        "scrollbar-slider-width": 4,
        "scrollbar-margin": 2,
        "progress-height": 8,
        "list-spacing": 0,
        "headerbar-padding-y": 0,
        "headerbar-padding-x": 6,
        "toolbar-spacing": 6,
        "dialog-width": 360,
        "sidebar-padding": 6,
        "sidebar-spacing": 2,
        "sidebar-row-padding": 12,
        "gap": 8,
        "inset": 8,
        "code-padding": 10,
        "inline-padding-x": 3,
        "empty-padding-y": 60,
        "small-button-padding-y": 2,
        "small-button-padding-x": 10,
    },
    "typography": {
        "text-scale": 1,
        "base-size": 13,
        "title-1": 1.81,
        "title-2": 1.36,
        "title-3": 1.2,
        "title-4": 1.1,
        "heading": 1,
        "caption-heading": 0.82,
        "caption": 0.82,
        "monospace": 1,
        "small": 0.8861623,
    },
    "shadows": {
        "card": "none",
        "popover": "none",
        "dialog": "none",
        "osd": "none",
    },
    "window-decorations": {
        "button-layout": ":minimize,maximize,close",
        "button-size": 22,
        "button-radius": 0,
        "titlebar-double-click": "toggle-maximize",
        "titlebar-middle-click": "none",
        "titlebar-right-click": "menu",
        "button-gap": 2,
        "button-icon-size": 16,
    },
}
