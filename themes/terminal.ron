        "popover-shade": "rgba(51, 255, 102, 0.55)",
        "sidebar-border": "rgba(51, 255, 102, 0.55)",
        "secondary-sidebar-bg": "#000000",
        "secondary-sidebar-fg": "#33ff66",
        "thumbnail-bg": "#001a08",
        "thumbnail-fg": "#33ff66",
