        "headerbar-bg": "#00330f",
        "headerbar-fg": "#33ff66",
        "sidebar-bg": "#00240a",
        "sidebar-fg": "#33ff66",
        "popover-bg": "#00240a",
        "popover-fg": "#33ff66",
        "dialog-bg": "#001a08",
        "dialog-fg": "#33ff66",
        "success": "#33ff66",
        "warning": "#ffcc00",
        "destructive": "#ff4d4d",
