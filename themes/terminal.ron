        "sidebar-fg": "#3a2a00",
        "popover-bg": "#fbf5de",
        "popover-fg": "#3a2a00",
        "dialog-bg": "#fbf5de",
        "dialog-fg": "#3a2a00",
        "success": "#2a6a1a",
        "warning": "#8a5a00",
        "destructive": "#a01010",
        "error": "#a01010",
        "accent-fg": "#fbf5de",
