// Phosphor terminal: green on black, square, flat, no shadows. The light variant is amber paper.
// Try it:  IAD_THEME=themes/terminal.conf cargo run -p iced-adaptive-design-gallery
{
    "theme": {
        "name": "Terminal",
        "key": "terminal",
    },
    "colors": {
        "accent": "#8a5a00",
        "window-bg": "#f4ecd2",
        "window-fg": "#3a2a00",
        "view-bg": "#fbf5de",
        "view-fg": "#3a2a00",
        "card-bg": "#fbf5de",
