        "card-shade": "rgba(58, 42, 0, 0.55)",
        "popover-shade": "rgba(58, 42, 0, 0.55)",
        "sidebar-border": "rgba(58, 42, 0, 0.55)",
        "secondary-sidebar-bg": "#f4ecd2",
        "secondary-sidebar-fg": "#3a2a00",
        "thumbnail-bg": "#fbf5de",
        "thumbnail-fg": "#3a2a00",
        "overview-bg": "#f4ecd2",
        "overview-fg": "#3a2a00",
        "active-toggle-bg": "rgba(138, 90, 0, 0.25)",
