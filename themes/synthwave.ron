// Retro neon on deep purple, with glowing shadows. The light variant is a lavender haze.
// Try it:  IAD_THEME=themes/synthwave.conf cargo run -p iced-adaptive-design-gallery
{
    "theme": {
        "name": "Synthwave",
        "key": "synthwave",
    },
    "colors": {
        "accent": "#c0149a",
        "window-bg": "#f3ecff",
        "window-fg": "#2a1250",
        "view-bg": "#ffffff",
        "view-fg": "#2a1250",
