        "secondary-sidebar-fg": "#2a1250",
        "thumbnail-bg": "#ffffff",
        "thumbnail-fg": "#2a1250",
        "overview-bg": "#f3ecff",
        "overview-fg": "#2a1250",
        "active-toggle-bg": "rgba(192, 20, 154, 0.25)",
        "active-toggle-fg": "#2a1250",
