        "sidebar-border": "rgba(0, 229, 255, 0.28)",
        "secondary-sidebar-bg": "#1a1033",
        "secondary-sidebar-fg": "#f0e6ff",
        "thumbnail-bg": "#221446",
        "thumbnail-fg": "#f0e6ff",
