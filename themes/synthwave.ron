    "metrics": {
        "space-xs": 4,
        "space-s": 6,
        "space-m": 12,
        "space-l": 18,
        "space-xl": 24,
        "radius-s": 3,
        "radius-m": 6,
        "radius-l": 10,
        "radius-menu": 6,
        "radius-popover": 10,
        "radius-toast": 10,
        "radius-window": 12,
        "button-padding-y": 5,
        "button-padding-x": 10,
        "button-min-height": 32,
        "entry-padding-y": 6,
        "entry-padding-x": 9,
        "entry-min-height": 32,
        "border-width": 1,
        "icon-size": 16,
        "row-padding-y": 6,
        "row-padding-x": 12,
        "row-min-height": 50,
        "row-spacing": 12,
        "card-padding": 12,
        "dialog-padding": 24,
        "popover-padding": 8,
        "page-padding-y": 24,
        "page-padding-x": 12,
        "group-spacing": 24,
        "clamp-maximum": 600,
        "headerbar-height": 44,
        "gutter": 16,
        "band-air": 8,
        "sidebar-width": 240,
        "sidebar-row-height": 36,
        "scrollbar-width": 8,
        "space-xxs": 2,
        "space-xxl": 36,
        "radius-pill": 999,
        "pill-padding-y": 10,
        "pill-padding-x": 32,
        "focus-ring-width": 2,
        "switch-size": 26,
        "checkbox-size": 20,
        "scrollbar-slider-width": 4,
        "scrollbar-margin": 2,
        "progress-height": 8,
        "list-spacing": 0,
        "headerbar-padding-y": 0,
        "headerbar-padding-x": 6,
        "toolbar-spacing": 6,
        "dialog-width": 360,
        "sidebar-padding": 6,
        "sidebar-spacing": 2,
        "sidebar-row-padding": 12,
        "gap": 8,
        "inset": 8,
        "code-padding": 10,
        "inline-padding-x": 3,
        "empty-padding-y": 60,
        "small-button-padding-y": 2,
        "small-button-padding-x": 10,
    },
    "typography": {
        "text-scale": 1,
        "base-size": 14.67,
        "title-1": 1.81,
        "title-2": 1.36,
        "title-3": 1.2,
        "title-4": 1.1,
        "heading": 1,
        "caption-heading": 0.82,
        "caption": 0.82,
        "monospace": 1,
        "small": 0.8861623,
    },
    "shadows": {
        "card": "0px 0px 14px 0px rgba(255, 47, 185, 0.28)",
        "popover": "0px 0px 22px 2px rgba(0, 229, 255, 0.35)",
        "dialog": "0px 0px 34px 4px rgba(255, 47, 185, 0.4)",
        "osd": "0px 0px 16px 0px rgba(0, 229, 255, 0.4)",
    },
    "window-decorations": {
        "button-layout": ":minimize,maximize,close",
        "button-size": 24,
        "button-radius": 30,
        "titlebar-double-click": "toggle-maximize",
        "titlebar-middle-click": "none",
        "titlebar-right-click": "menu",
        "button-gap": 6,
        "button-icon-size": 16,
    },
}
