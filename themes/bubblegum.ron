        "popover": "0px 8px 26px 0px rgba(255, 79, 163, 0.3)",
        "dialog": "0px 12px 40px 0px rgba(255, 79, 163, 0.35)",
        "osd": "0px 4px 14px 0px rgba(255, 79, 163, 0.3)",
    },
    "window-decorations": {
        "button-layout": ":minimize,maximize,close",
        "button-size": 30,
        "button-radius": 25,
        "titlebar-double-click": "toggle-maximize",
        "titlebar-middle-click": "none",
        "titlebar-right-click": "menu",
        "button-gap": 8,
        "button-inset": 9,
        "button-separation": 20,
        "button-icon-size": 16,
