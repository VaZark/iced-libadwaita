    "metrics": {
        "space-xs": 4,
        "space-s": 6,
        "space-m": 12,
        "space-l": 18,
        "space-xl": 24,
        "radius-s": 8,
        "radius-m": 100,
        "radius-l": 16,
        "radius-menu": 12,
        "radius-popover": 16,
        "radius-toast": 100,
        "radius-window": 16,
        "button-padding-y": 6,
        "button-padding-x": 18,
        "button-min-height": 32,
        "entry-padding-y": 6,
        "entry-padding-x": 12,
        "entry-min-height": 32,
        "border-width": 1,
        "icon-size": 16,
        "row-padding-y": 6,
        "row-padding-x": 12,
        "row-min-height": 52,
        "row-spacing": 12,
        "card-padding": 16,
        "dialog-padding": 24,
        "popover-padding": 8,
        "page-padding-y": 24,
        "page-padding-x": 12,
        "group-spacing": 24,
        "clamp-maximum": 600,
        "headerbar-height": 48,
        "gutter": 20,
        "band-air": 8,
        "sidebar-width": 260,
        "sidebar-row-height": 40,
        "scrollbar-width": 8,
        "space-xxs": 2,
        "space-xxl": 36,
        "radius-pill": 999,
        "pill-padding-y": 10,
        "pill-padding-x": 32,
        "focus-ring-width": 2,
        "switch-size": 26,
        "checkbox-size": 20,
        "scrollbar-slider-width": 4,
        "scrollbar-margin": 2,
        "progress-height": 8,
        "list-spacing": 0,
        "headerbar-padding-y": 0,
        "headerbar-padding-x": 6,
        "toolbar-spacing": 6,
        "dialog-width": 360,
        "sidebar-padding": 6,
        "sidebar-spacing": 2,
        "sidebar-row-padding": 12,
        "gap": 12,
        "inset": 12,
        "code-padding": 10,
        "inline-padding-x": 3,
        "empty-padding-y": 60,
        "small-button-padding-y": 2,
        "small-button-padding-x": 10,
    },
    "typography": {
        "text-scale": 1,
        "base-size": 14,
        "title-1": 2,
        "title-2": 1.5,
        "title-3": 1.25,
        "title-4": 1.1,
        "heading": 1,
        "caption-heading": 0.86,
        "caption": 0.86,
        "monospace": 1,
        "small": 0.8861623,
    },
    "shadows": {
        "card": "none",
        "popover": "0px 6px 24px 0px rgba(0, 0, 0, 0.35)",
        "dialog": "0px 10px 36px 0px rgba(0, 0, 0, 0.45)",
        "osd": "0px 4px 16px 0px rgba(0, 0, 0, 0.35)",
    },
    "window-decorations": {
        "button-layout": ":minimize,maximize,close",
        "button-size": 32,
        "button-radius": 50,
        "button-fill": "circle",
        "titlebar-double-click": "toggle-maximize",
        "titlebar-middle-click": "none",
        "titlebar-right-click": "menu",
        "button-gap": 8,
        "button-icon-size": 16,
    },
}
