        "secondary-sidebar-bg": "#d7d7d7",
        "secondary-sidebar-fg": "#1b1b1b",
        "thumbnail-bg": "#e6e6e6",
        "thumbnail-fg": "#1b1b1b",
        "overview-bg": "#d7d7d7",
        "overview-fg": "#1b1b1b",
