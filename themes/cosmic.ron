// System76 COSMIC look: round, calm greys, teal accent, circular window buttons.
// Try it:  IAD_THEME=themes/cosmic.conf cargo run -p iced-adaptive-design-gallery
{
    "theme": {
        "name": "COSMIC",
        "key": "cosmic",
    },
    "colors": {
        "accent": "#00525a",
        "window-bg": "#d7d7d7",
        "window-fg": "#1b1b1b",
        "view-bg": "#e6e6e6",
        "view-fg": "#1b1b1b",
