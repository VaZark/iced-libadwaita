        "headerbar-shade": "rgba(196, 196, 196, 0.18)",
        "headerbar-darker-shade": "rgba(196, 196, 196, 0.18)",
        "card-shade": "rgba(196, 196, 196, 0.18)",
        "popover-shade": "rgba(196, 196, 196, 0.18)",
        "sidebar-border": "rgba(196, 196, 196, 0.18)",
        "secondary-sidebar-bg": "#1b1b1b",
        "secondary-sidebar-fg": "#c4c4c4",
        "thumbnail-bg": "#262626",
