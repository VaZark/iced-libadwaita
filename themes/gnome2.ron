// Modern MATE 1.26: silver window chrome, compact desktop panels and conventional controls.
// Try it:  IAD_THEME=themes/gnome2.conf cargo run -p iced-adaptive-design-theme-toys -- gnome2
{
    "theme": {
        "name": "MATE 1.26 (legacy gnome2 alias)",
        "key": "gnome2",
    },
    "colors": {
        "accent": "#4a90d9",
        "window-bg": "#d6d6d6",
        "window-fg": "#2e3436",
        "view-bg": "#ffffff",
        "view-fg": "#2e3436",
        "card-bg": "#d6d6d6",
        "card-fg": "#2e3436",
        "headerbar-bg": "#d9d4cc",
        "headerbar-fg": "#2e3436",
        "sidebar-bg": "#f7f5f2",
        "sidebar-fg": "#2e3436",
        "popover-bg": "#f7f5f2",
        "popover-fg": "#2e3436",
        "dialog-bg": "#efebe7",
        "dialog-fg": "#2e3436",
        "success": "#4e9a06",
        "warning": "#c4a000",
        "destructive": "#cc0000",
        "error": "#cc0000",
        "accent-fg": "#ffffff",
        "accent-text": "#4a90d9",
        "destructive-fg": "#ffffff",
        "destructive-text": "#cc0000",
        "success-fg": "#ffffff",
        "success-text": "#4e9a06",
        "warning-fg": "#2e3436",
        "warning-text": "#c4a000",
        "error-fg": "#ffffff",
        "error-text": "#cc0000",
        "headerbar-border": "rgba(138, 133, 124, 0.9)",
        "headerbar-shade": "rgba(138, 133, 124, 0.9)",
        "headerbar-darker-shade": "rgba(138, 133, 124, 0.9)",
        "card-shade": "rgba(138, 133, 124, 0.9)",
        "popover-shade": "rgba(138, 133, 124, 0.9)",
        "sidebar-border": "rgba(138, 133, 124, 0.9)",
        "secondary-sidebar-bg": "#efebe7",
        "secondary-sidebar-fg": "#2e3436",
        "thumbnail-bg": "#ffffff",
        "thumbnail-fg": "#2e3436",
        "overview-bg": "#efebe7",
        "overview-fg": "#2e3436",
        "active-toggle-bg": "#c3d9ee",
        "active-toggle-fg": "#2e3436",
        "shade": "rgba(138, 133, 124, 0.9)",
        "scrollbar-outline": "rgba(239, 235, 231, 0)",
        "primary": "#4a90d9",
        "primary-fg": "#ffffff",
        "primary-text": "#4a90d9",
        "focus-ring": "#4a90d9",
    },
    "dark:colors": {
        "accent": "#4a90d9",
        "window-bg": "#2e3436",
        "window-fg": "#eeeeec",
        "view-bg": "#232729",
        "view-fg": "#eeeeec",
        "card-bg": "#363c3e",
        "card-fg": "#eeeeec",
        "headerbar-bg": "#3b4143",
        "headerbar-fg": "#eeeeec",
        "sidebar-bg": "#2a2f31",
        "sidebar-fg": "#eeeeec",
        "popover-bg": "#363c3e",
        "popover-fg": "#eeeeec",
        "dialog-bg": "#2e3436",
        "dialog-fg": "#eeeeec",
        "success": "#73d216",
        "warning": "#edd400",
        "destructive": "#ef2929",
        "error": "#ef2929",
        "accent-fg": "#ffffff",
        "accent-text": "#4a90d9",
        "destructive-fg": "#ffffff",
        "destructive-text": "#ef2929",
        "success-fg": "#ffffff",
        "success-text": "#73d216",
        "warning-fg": "#eeeeec",
        "warning-text": "#edd400",
        "error-fg": "#ffffff",
        "error-text": "#ef2929",
        "headerbar-border": "rgba(238, 238, 236, 0.25)",
        "headerbar-shade": "rgba(238, 238, 236, 0.25)",
        "headerbar-darker-shade": "rgba(238, 238, 236, 0.25)",
        "card-shade": "rgba(238, 238, 236, 0.25)",
        "popover-shade": "rgba(238, 238, 236, 0.25)",
        "sidebar-border": "rgba(238, 238, 236, 0.25)",
        "secondary-sidebar-bg": "#2e3436",
        "secondary-sidebar-fg": "#eeeeec",
        "thumbnail-bg": "#232729",
        "thumbnail-fg": "#eeeeec",
        "overview-bg": "#2e3436",
        "overview-fg": "#eeeeec",
        "active-toggle-bg": "#34506b",
        "active-toggle-fg": "#eeeeec",
        "shade": "rgba(238, 238, 236, 0.25)",
        "scrollbar-outline": "rgba(46, 52, 54, 0)",
        "primary": "#3a7fc9",
        "primary-fg": "#ffffff",
        "primary-text": "#4a90d9",
        "focus-ring": "#729fcf",
    },
    "metrics": {
        "space-xs": 4,
        "space-s": 6,
        "space-m": 12,
        "space-l": 18,
        "space-xl": 24,
        "radius-s": 3,
        "radius-m": 0,
        "radius-l": 4,
        "radius-menu": 3,
        "radius-popover": 3,
        "radius-toast": 4,
        "radius-window": 6,
        "button-padding-y": 3,
        "button-padding-x": 12,
        "button-min-height": 26,
        "entry-padding-y": 3,
        "entry-padding-x": 5,
        "entry-min-height": 26,
        "border-width": 1,
        "icon-size": 16,
        "row-padding-y": 6,
        "row-padding-x": 12,
        "row-min-height": 32,
        "row-spacing": 12,
        "card-padding": 10,
        "dialog-padding": 24,
        "popover-padding": 8,
        "page-padding-y": 24,
        "page-padding-x": 12,
        "group-spacing": 24,
        "clamp-maximum": 600,
        "headerbar-height": 20,
        "gutter": 12,
        "band-air": 8,
        "sidebar-width": 200,
        "sidebar-row-height": 24,
        "scrollbar-width": 16,
        "space-xxs": 2,
        "space-xxl": 36,
        "radius-pill": 999,
        "pill-padding-y": 10,
        "pill-padding-x": 32,
        "focus-ring-width": 1,
        "switch-size": 26,
        "checkbox-size": 20,
        "scrollbar-slider-width": 14,
        "scrollbar-margin": 0,
        "progress-height": 14,
        "list-spacing": 0,
        "headerbar-padding-y": 0,
        "headerbar-padding-x": 6,
        "toolbar-spacing": 6,
        "dialog-width": 360,
        "sidebar-padding": 6,
        "sidebar-spacing": 2,
        "sidebar-row-padding": 12,
        "gap": 8,
        "inset": 8,
        "code-padding": 10,
        "inline-padding-x": 3,
        "empty-padding-y": 60,
        "small-button-padding-y": 2,
        "small-button-padding-x": 10,
        "focus-style": "ring",
    },
    "typography": {
        "text-scale": 1,
        "base-size": 10,
        "title-1": 1.81,
        "title-2": 1.36,
        "title-3": 1.2,
        "title-4": 1.1,
        "heading": 1,
        "caption-heading": 0.82,
        "caption": 0.82,
        "monospace": 1,
        "small": 0.8861623,
        "font-family": "Sans",
        "monospace-font-family": "Monospace",
    },
    "window-decorations": {
        "button-layout": "icon:minimize,maximize,close",
        "button-size": 18,
        "button-gap": 2,
        "button-radius": 25,
        "button-icon-size": 10,
        "titlebar-double-click": "toggle-maximize",
        "titlebar-middle-click": "none",
        "titlebar-right-click": "menu",
        "frame-border-width": 1,
        "frame-border": "#8a857c",
        "frame-border-style": "solid",
        "titlebar-align": "start",
        "titlebar-font-weight": "bold",
        "titlebar-icon": true,
        "button-style": "headerbar",
        "flat-headerbars": false,
    },
    "shadows": {
        "card": "none",
        "popover": "1px 1px 4px 0px rgba(0, 0, 0, 0.3)",
        "dialog": "2px 3px 8px 0px rgba(0, 0, 0, 0.4)",
        "osd": "none",
    },
    "gradients": {
        "titlebar": (angle: 180.0, stops: [(0.0, "#eeeeee"), (1.0, "#c5c5c5")]),
        "headerbar": (angle: 180.0, stops: [(0.0, "#eeeeee"), (1.0, "#c5c5c5")]),
        "progress": (angle: 180.0, stops: [(0.0, "#7fb4ea"), (1.0, "#4a90d9")]),
    },
    "frame.card": {
        "border-style": "solid",
        "border-width": 1,
        "radius": 3,
    },
    "frame.field": {
        "border-style": "solid",
        "border-width": 1,
        "bg": "#ffffff",
    },
    "button.default": {
        "bg-gradient": (angle: 180.0, stops: [(0.0, "#fdfdfc"), (1.0, "#e8e5df")]),
        "hover-bg-gradient": (angle: 180.0, stops: [(0.0, "#ffffff"), (1.0, "#f0eee9")]),
        "active-bg-gradient": (angle: 180.0, stops: [(0.0, "#d4d0c8"), (1.0, "#e8e5df")]),
        "fg": "#2e3436",
        "border": "#8a857c",
        "border-width": 1,
        "radius": 3,
    },
    "button.suggested": {
        "bg-gradient": (angle: 180.0, stops: [(0.0, "#6fa8e6"), (1.0, "#4a90d9")]),
        "hover-bg-gradient": (angle: 180.0, stops: [(0.0, "#88b9ee"), (1.0, "#5a9de0")]),
        "fg": "#ffffff",
        "border": "#2f6aa8",
        "border-width": 1,
        "radius": 3,
    },
    "button.headerbar": {
        "bg-gradient": (angle: 180.0, stops: [(0.0, "#fdfdfc"), (1.0, "#e0dcd4")]),
        "hover-bg-gradient": (angle: 180.0, stops: [(0.0, "#ffffff"), (1.0, "#ece9e3")]),
        "fg": "#2e3436",
        "border": "#8a857c",
        "border-width": 1,
        "radius": 4,
    },
    "button.destructive": {
        "bg-gradient": (angle: 180.0, stops: [(0.0, "#e66"), (1.0, "#cc0000")]),
        "fg": "#ffffff",
        "border": "#8a0000",
        "border-width": 1,
        "radius": 3,
    },
    // Selected content is distinct from a raised command button.
    "button.opaque": {
        "bg": "#4a90d9",
        "fg": "#ffffff",
        "hover-bg": "#4a90d9",
        "active-bg": "#4a90d9",
        "border-width": 0,
        "radius": 0,
    },
    // Tree geometry belongs to the theme, not per-toy widget overrides.
    "tree": {
        "row-height": 22,
        "level-offset": 18,
        "icon-size": 16,
        "handle-padding": 3,
        "icon-padding": 2,
        "label-padding": 3,
        "checkbox-padding": 2,
        "row-radius": 0,
        "expander-icon-inset": 2,
        "connector-width": 1,
    },
    "button.link": {
        "fg": "#ffffff",
        "hover-bg": "#356ab0",
        "active-bg": "#245e94",
    },
}
